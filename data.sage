#########################
# MATRIX MULTIPLICATION #
#########################

R = PolynomialRing(FIELD, ["x", "y", "z", "w"])
x,y,z,w = R.gens()
matrix_mult_2x2 = Matrix([
    [x,y,0,0],
    [z,w,0,0],
    [0,0,x,y],
    [0,0,z,w]
])


#####################
# STRUCTURE TENSORS #
#####################

R = PolynomialRing(FIELD, 8, "x")
x0, x1, x2, x3, x4, x5, x6, x7 = R.gens()
T_oct = Matrix([
    [x0,  x1,   0,  0,  x4,  0, x6,   0],
    [ 0,   0,  x0, x1,  x5,  0, x7,   0],
    [x2,  x3,   0,  0,   0, x4,  0,  x6],
    [ 0,   0,  x2, x3,   0, x5,  0,  x7],
    [ 0, -x5,   0, x4,   0,  0, x2, -x0],
    [x5,   0, -x4,  0,   0,  0, x3, -x1],
    [ 0, -x7,   0, x6, -x2, x0,  0,   0],
    [x7,   0, -x6,  0, -x3, x1,  0,   0]
])


###############
# MINIMAL BRK #
###############

R = PolynomialRing(FIELD, 5, "x")
x0, x1, x2, x3, x4 = R.gens()

T1_10 = Matrix([
    [x0,  0,  0,  0,  0],
    [ 0, x0,  0,  0,  0],
    [ 0,  0, x0,  0,  0],
    [ 0, x1, x3, x0,  0],
    [ 0, x2, x4,  0, x0]
])

T1_11 = Matrix([
    [x0,  0,  0,  0,  0],
    [ 0, x0,  0,  0,  0],
    [ 0,  0, x0,  0,  0],
    [x2, x3, x4, x0,  0],
    [x1, x2, x3,  0, x0]
])

T1_12 = Matrix([
    [x0,  0,  0,  0,  0],
    [ 0, x0,  0,  0,  0],
    [ 0,  0, x0,  0,  0],
    [x1,  0, x4, x0,  0],
    [x2, x3, x1,  0, x0]
])

T1_19 = Matrix([
    [x0,  0,  0,  0,  0],
    [ 0, x0,  0,  0,  0],
    [x1,  0, x0,  0,  0],
    [x3, x4,  0, x0,  0],
    [x2, x3, x1,  0, x0]
])

T2_7 = Matrix([
    [x0,   0,  0,  0,  0],
    [ 0,  x0,  0,  0,  0],
    [x1,  x2, x0,  0,  0],
    [x3, -x1,  0, x0,  0],
    [ 0,   0,  0,  0, x0+x4]
])

T_O58 = Matrix([
    [x0,  0,  x1,  x2, x4],
    [x4, x0,  x3, -x1,  0],
    [ 0,  0,  x0,   0,  0],
    [ 0,  0, -x4,  x0,  0],
    [ 0,  0,   0,  x4,  0]
])

T_O57 = Matrix([
    [x0,  0, x1,  x2, x4],
    [ 0, x0, x3, -x1,  0],
    [ 0,  0, x0,   0,  0],
    [ 0,  0,  0,  x0,  0],
    [ 0,  0,  0,  x4,  0]
])

R = PolynomialRing(FIELD, 4, "x")
x0, x1, x2, x3 = R.gens()
U2_7 = Matrix([
    [x0,   0,  0,  0],
    [ 0,  x0,  0,  0],
    [x1,  x2, x0,  0],
    [x3, -x1,  0, x0]
])


###############
# REP. THEORY #
###############

R = PolynomialRing(FIELD, 6, "x")
x0, x1, x2, x3, x4, x5 = R.gens()
E6 = Matrix([
    [ 2*x3,  2*x4,  2*x5,     0,     0,     0],
    [  -x1,   -x2,     0,    x4,  2*x5,     0],
    [    0,   -x1,   -x2, -2*x3,   -x4,     0],
    [ 2*x0,     0,     0, -2*x2,     0,  2*x5],
    [    0,  2*x0,     0,    x1,   -x2,   -x4],
    [    0,     0,  2*x0,     0,  2*x1,  2*x3]
])
